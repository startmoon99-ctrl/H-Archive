# Supabase 연결. 이 파일을 .env.local로 복사해 키를 채운다(.env.local은 git에 올라가지 않는다).
# 두 값이 모두 있으면 원격 저장소(로그인 필요), 하나라도 비어 있으면 이 브라우저에만 저장한다.
# 배포본에는 Vercel → Project Settings → Environment Variables에 같은 두 값을 넣는다.

# Supabase 대시보드 첫 화면에 보이는 프로젝트 주소
VITE_SUPABASE_URL=https://opntjrkmdjzqxcwfujqz.supabase.co

# 공개용 키(Publishable / anon). service_role(secret) 키는 절대 넣지 않는다.
VITE_SUPABASE_PUBLISHABLE_KEY=
